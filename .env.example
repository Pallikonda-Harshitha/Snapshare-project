PORT=3000
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional. Store data in MongoDB instead of data/db.json.
# Local MongoDB (view it in MongoDB Compass with the same address):
#   MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas: paste the connection string from Atlas > Connect > Drivers.
MONGODB_URI=
MONGODB_DB=snapshare
